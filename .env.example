# ---------------------------------------------------------------------------
# TaskFlow API - variables de entorno (plantilla)
#
# Copia este archivo a tu configuración local y rellena valores reales.
# OJO: Spring Boot NO lee archivos .env automáticamente. Estas variables deben
# existir en el entorno del proceso: PowerShell/Bash, el IDE (IntelliJ,
# VS Code) o la plataforma de despliegue (Render, Docker, ...).
#
# Este archivo es una plantilla pública: NUNCA pongas aquí secretos reales.
# ---------------------------------------------------------------------------

# --- Base de datos PostgreSQL (obligatorias) -------------------------------
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-contrasena

# --- Secreto de firma de los JWT (obligatoria) -----------------------------
# Cadena larga y aleatoria (32 caracteres como mínimo; se recomienda 64).
# Genera una con: openssl rand -base64 64
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-64-caracteres-0123456789

# --- Servidor --------------------------------------------------------------
# Puerto HTTP del backend. El frontend debe apuntar a esta URL.
PORT=8080

# --- CORS ------------------------------------------------------------------
# Origen(es) del frontend autorizados, separados por comas. No se admiten
# comodines. En Render define el origen real del frontend desplegado.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Datasource (opcional) -------------------------------------------------
# Sobrescribe la URL definida en application.yaml
# (por defecto jdbc:postgresql://localhost:5434/taskflow).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/taskflow

# --- Flyway (opcional) -----------------------------------------------------
# FLYWAY_ENABLED desactiva las migraciones (solo lo usa el test de contexto H2).
FLYWAY_ENABLED=true
# Activar UNA sola vez para adoptar una base de datos ya existente
# (ver docs/base-de-datos.md). Debe quedar en false el resto del tiempo.
FLYWAY_BASELINE_ON_MIGRATE=false

# --- Rate limiting del login (opcional) ------------------------------------
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW=5m
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=30
# Activar solo si hay un proxy de confianza delante (Render, nginx, ...).
LOGIN_RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
# memory = estado por instancia; redis = estado compartido entre réplicas.
LOGIN_RATE_LIMIT_STORE=memory

# --- Redis (opcional, solo con LOGIN_RATE_LIMIT_STORE=redis) ---------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Solo para tests de integración de Flyway (opcional) -------------------
# Base de MANTENIMIENTO: los tests crean y borran bases desechables
# taskflow_it_*. Si no se define, esos tests se omiten.
# TASKFLOW_PG_IT_URL=jdbc:postgresql://localhost:5434/postgres
